<?xml version="1.0" encoding="UTF-8"?>
<!--
  AWS_IoT_Relay - where every Salesforce to AWS call goes (the name is the
  setting Named_Credential__c on Device_Platform_Setting__mdt.Default).

  One-time setup: scripts/bootstrap-salesforce.sh creates it when the org has
  none and never changes it afterwards. It is NOT in force-app/, so the
  pipeline never deploys it (bootstrap/README.md).

  Placeholder: the URL. The script's --url replaces it with the stack's
  QueueDepthEndpoint; without it, change it in Setup (docs/INSTALL.md, 7c).
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>AWS IoT Relay</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://dummy-replace-me.example.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <externalCredential>AWS_IoT_Relay</externalCredential>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
    </namedCredentialParameters>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
</NamedCredential>
