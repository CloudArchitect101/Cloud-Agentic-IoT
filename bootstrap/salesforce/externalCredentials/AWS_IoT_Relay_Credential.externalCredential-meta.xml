<?xml version="1.0" encoding="UTF-8"?>
<!--
  AWS_IoT_Relay_Credential - how Salesforce signs its calls to the device API.

  One-time setup: scripts/bootstrap-salesforce.sh creates it when the org has
  none and never changes it afterwards. It is NOT in force-app/, so the
  pipeline never deploys it (bootstrap/README.md).

  Placeholder: the Region, us-east-1. The script's region option replaces it.

  Not in this file, because Salesforce keeps them as the principals' stored
  credentials, not as metadata. An admin types them in Setup, on this
  external credential (docs/INSTALL.md, step 7b):
    - STS Access Key and STS Access Secret (the caller IAM user's key)
    - IAM Role ARN, on the principal SalesforceCaller

  The rows below are the ones a retrieve of a working, hand-made credential
  returned (Nov 25), with the Region swapped for the placeholder.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>AwsSv4</authenticationProtocol>
    <!-- Obtain Temporary IAM Credentials via STS: on. -->
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsSv4</parameterName>
        <parameterType>AuthProtocolVariant</parameterType>
        <parameterValue>AwsSv4_STS</parameterValue>
    </externalCredentialParameters>
    <!-- IAM User Identified by Access Key. The key and its secret are typed in Setup. -->
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsStsPrincipal</parameterName>
        <parameterType>AwsStsPrincipal</parameterType>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsService</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>execute-api</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsRegion</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>us-east-1</parameterValue>
    </externalCredentialParameters>
    <!-- The principal AWS_IoT_Relay_Callers gives access to. Its IAM Role ARN is typed in Setup. -->
    <externalCredentialParameters>
        <parameterGroup>SalesforceCaller</parameterGroup>
        <parameterName>SalesforceCaller</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <!-- Additional Status Codes for Token Refresh: API Gateway answers an
         expired STS session with 403, and without this every call fails an
         hour after the first one. -->
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AdditionalRefreshStatusCode</parameterName>
        <parameterType>AdditionalRefreshStatusCode</parameterType>
        <parameterValue>403</parameterValue>
    </externalCredentialParameters>
    <label>AWS_IoT_Relay_Credential</label>
</ExternalCredential>
