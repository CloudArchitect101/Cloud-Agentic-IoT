<?xml version="1.0" encoding="UTF-8"?>
<Queue xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      The care team's Case queue. The agent's escalations and the
      room-temperature rule's Cases go here (Device_Platform_Setting.Default
      names it), and the queue indicator shows its depth. Members are added
      per org: Setup > Queues > Care Team Queue.
    -->
    <doesSendEmailToMembers>false</doesSendEmailToMembers>
    <name>Care Team Queue</name>
    <!-- Omni-Channel routing, needed for the portal chat's fallback
         (queueRoutingConfigs/Care_Team_Chat). -->
    <queueRoutingConfig>Care_Team_Chat</queueRoutingConfig>
    <queueSobject>
        <sobjectType>Case</sobjectType>
    </queueSobject>
    <!-- The patient portal chat's fallback: a conversation the Patient
         Portal Agent cannot take (Route_Patient_Portal_Chat) waits here for
         the care team. The ward board counts only Cases, so it is not moved. -->
    <queueSobject>
        <sobjectType>MessagingSession</sobjectType>
    </queueSobject>
</Queue>
