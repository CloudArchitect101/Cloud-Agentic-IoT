<?xml version="1.0" encoding="UTF-8"?>
<BotVersion xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Version 1 of the Patient Care Agent. conversationDefinitionPlanners links it
      to the Patient_Care_Planner planner bundle, which brings the Patient Device
      Monitoring topic and its three actions. A deploy leaves it Inactive:
      activating it is a person's decision, made with sf agent activate or in
      Setup (docs/SETUP.md, 6.4).
      entryDialog is required, so the version carries the welcome and error
      dialogs every agent has.
    -->
    <fullName>v1</fullName>
    <articleAnswersGPTEnabled>false</articleAnswersGPTEnabled>
    <botDialogs>
        <botSteps>
            <botMessages>
                <message>Hi, I'm the Patient Care Agent. Give me a device serial number and I can tell you what it is reporting, find the ward procedure that applies, or escalate a condition to the care team.</message>
                <messageIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c01</messageIdentifier>
            </botMessages>
            <stepIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c02</stepIdentifier>
            <type>Message</type>
        </botSteps>
        <botSteps>
            <stepIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c03</stepIdentifier>
            <type>Wait</type>
        </botSteps>
        <developerName>Welcome</developerName>
        <isPlaceholderDialog>false</isPlaceholderDialog>
        <label>Welcome</label>
        <showInFooterMenu>false</showInFooterMenu>
    </botDialogs>
    <botDialogs>
        <botSteps>
            <botMessages>
                <message>Something went wrong. Try again.</message>
                <messageIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c04</messageIdentifier>
            </botMessages>
            <stepIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c05</stepIdentifier>
            <type>Message</type>
        </botSteps>
        <botSteps>
            <stepIdentifier>5b6c2e0a-6d1f-4a51-9c3e-1f0d7a8b2c06</stepIdentifier>
            <type>Wait</type>
        </botSteps>
        <developerName>Error_Handling</developerName>
        <isPlaceholderDialog>false</isPlaceholderDialog>
        <label>Error Handler</label>
        <showInFooterMenu>false</showInFooterMenu>
    </botDialogs>
    <citationsEnabled>false</citationsEnabled>
    <conversationDefinitionPlanners>
        <genAiPlannerName>Patient_Care_Planner</genAiPlannerName>
    </conversationDefinitionPlanners>
    <conversationSystemDialogs>
        <dialog>Error_Handling</dialog>
        <type>ErrorHandling</type>
    </conversationSystemDialogs>
    <entryDialog>Welcome</entryDialog>
    <intentDisambiguationEnabled>false</intentDisambiguationEnabled>
    <intentV3Enabled>false</intentV3Enabled>
    <knowledgeActionEnabled>false</knowledgeActionEnabled>
    <knowledgeFallbackEnabled>false</knowledgeFallbackEnabled>
    <role>You help hospital care team members understand what patient room and medication storage monitors are reporting, point them to the ward procedure that applies, citing its SOP ID, and escalate conditions that need human attention. You describe readings and procedures; you never diagnose or recommend treatment.</role>
    <smallTalkEnabled>false</smallTalkEnabled>
    <stopRecPrompts>false</stopRecPrompts>
    <stopWelcomePrompts>false</stopWelcomePrompts>
    <surfacesEnabled>false</surfacesEnabled>
    <toneType>Neutral</toneType>
</BotVersion>
