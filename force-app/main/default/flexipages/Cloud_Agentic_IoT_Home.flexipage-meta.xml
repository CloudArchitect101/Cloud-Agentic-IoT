<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>The Cloud Agentic IoT app's Home page: the usage card alone, with this month's AWS spend against its limit and the Salesforce limits the org has used. The app makes it its Home page on desktop; other apps and the org keep theirs.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>platformUsageCard</componentName>
                <identifier>platformUsageCard</identifier>
            </componentInstance>
        </itemInstances>
        <name>top</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <name>bottomLeft</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <name>bottomRight</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <name>sidebar</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Cloud Agentic IoT Home</masterLabel>
    <template>
        <name>home:desktopTemplate</name>
    </template>
    <type>HomePage</type>
</FlexiPage>
