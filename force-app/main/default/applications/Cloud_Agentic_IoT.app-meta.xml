<?xml version="1.0" encoding="UTF-8"?>
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- The record page each object opens with in this app, for every
         profile, System Administrator included. -->
    <actionOverrides>
        <actionName>View</actionName>
        <content>Device_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>Asset</pageOrSobjectType>
    </actionOverrides>
    <actionOverrides>
        <actionName>View</actionName>
        <content>Patient_Vitals_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>Patient_Vitals__c</pageOrSobjectType>
    </actionOverrides>
    <actionOverrides>
        <actionName>View</actionName>
        <content>Device_Command_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>Device_Command__c</pageOrSobjectType>
    </actionOverrides>
    <actionOverrides>
        <actionName>View</actionName>
        <content>Wi_Fi_Network_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>Wi_Fi_Network__c</pageOrSobjectType>
    </actionOverrides>
    <!-- The app's Home page: the Business Value dashboard, then the usage card. It replaces Home in this
         app only; other apps, and the org's own Home page, keep theirs.
         Salesforce takes a Home page override for desktop (Large) only, so
         the mobile app keeps its standard Home. -->
    <actionOverrides>
        <actionName>Tab</actionName>
        <content>Cloud_Agentic_IoT_Home</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
        <pageOrSobjectType>standard-home</pageOrSobjectType>
    </actionOverrides>
    <!-- The app's icon in the App Launcher and the nav bar: the pixel "101"
         cloud (the CloudArchitect101 favicon), a ContentAsset on a transparent
         background, on the header colour. shouldOverrideOrgTheme is the
         "Use the app's image and color instead of the org's custom theme"
         box: on, so an org theme cannot hide the logo or the colour.
         logoVersion must match the ContentAsset's latest version number. -->
    <brand>
        <headerColor>#0B5CAB</headerColor>
        <logo>CloudAgenticIoTLogo</logo>
        <logoVersion>2</logoVersion>
        <shouldOverrideOrgTheme>true</shouldOverrideOrgTheme>
    </brand>
    <description>Devices, their readings, the commands sent to them and the Wi-Fi networks they join.</description>
    <formFactors>Small</formFactors>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <label>Cloud Agentic IoT</label>
    <navType>Standard</navType>
    <tabs>standard-home</tabs>
    <tabs>standard-Asset</tabs>
    <tabs>Patient_Vitals__c</tabs>
    <tabs>Device_Command__c</tabs>
    <tabs>Wi_Fi_Network__c</tabs>
    <tabs>standard-Case</tabs>
    <tabs>standard-Account</tabs>
    <uiType>Lightning</uiType>
</CustomApplication>
