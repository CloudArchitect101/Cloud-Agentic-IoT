<?xml version="1.0" encoding="UTF-8"?>
<CustomEventDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Queue Depth Change</label>
    <pluralLabel>Queue Depth Changes</pluralLabel>
    <processOwnership>Own</processOwnership>
    <publisherId>Platform</publisherId>
    <enabled>true</enabled>
    <fields>
        <fullName>Queue_Developer_Name__c</fullName>
        <label>Queue Developer Name</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Device_Id__c</fullName>
        <label>Device ID</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Open_Case_Count__c</fullName>
        <label>Open Case Count</label>
        <precision>5</precision>
        <scale>0</scale>
        <required>true</required>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Intensity__c</fullName>
        <label>Intensity</label>
        <description>Open case count scaled 0-100 against the binding's Full Speed Depth.</description>
        <precision>3</precision>
        <scale>0</scale>
        <required>true</required>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Motor_State__c</fullName>
        <label>Motor State</label>
        <picklist>
            <customType>picklist</customType>
            <values>
                <name>IDLE</name>
                <label>IDLE</label>
            </values>
            <values>
                <name>ACTIVE</name>
                <label>ACTIVE</label>
            </values>
        </picklist>
        <required>true</required>
        <type>Picklist</type>
    </fields>
</CustomEventDefinition>
