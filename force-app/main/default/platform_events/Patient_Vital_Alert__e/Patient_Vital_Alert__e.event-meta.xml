<?xml version="1.0" encoding="UTF-8"?>
<CustomEventDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Patient Vital Alert</label>
    <pluralLabel>Patient Vital Alerts</pluralLabel>
    <processOwnership>Own</processOwnership>
    <publisherId>Platform</publisherId>
    <enabled>true</enabled>
    <fields>
        <fullName>Patient_Device_Id__c</fullName>
        <label>Device ID</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Alert_Type__c</fullName>
        <label>Alert Type</label>
        <picklist>
            <customType>picklist</customType>
            <values>
                <name>CRITICAL_VITALS</name>
                <label>CRITICAL_VITALS</label>
            </values>
            <values>
                <name>ABNORMAL_TREND</name>
                <label>ABNORMAL_TREND</label>
            </values>
            <values>
                <name>DEVICE_DISCONNECTED</name>
                <label>DEVICE_DISCONNECTED</label>
            </values>
        </picklist>
        <required>true</required>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Risk_Score__c</fullName>
        <label>Risk Score</label>
        <precision>3</precision>
        <scale>0</scale>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Patient_State__c</fullName>
        <label>Patient State</label>
        <picklist>
            <customType>picklist</customType>
            <values>
                <name>CRITICAL</name>
                <label>CRITICAL</label>
            </values>
            <values>
                <name>AT_RISK</name>
                <label>AT_RISK</label>
            </values>
            <values>
                <name>STABLE</name>
                <label>STABLE</label>
            </values>
        </picklist>
        <required>true</required>
        <type>Picklist</type>
    </fields>
    <fields>
        <fullName>Heart_Rate__c</fullName>
        <label>Heart Rate</label>
        <precision>5</precision>
        <scale>1</scale>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>SpO2__c</fullName>
        <label>SpO2</label>
        <precision>4</precision>
        <scale>1</scale>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Temperature__c</fullName>
        <label>Temperature</label>
        <precision>3</precision>
        <scale>1</scale>
        <type>Number</type>
    </fields>
    <fields>
        <fullName>Message__c</fullName>
        <label>Alert Message</label>
        <length>500</length>
        <type>Text</type>
    </fields>
</CustomEventDefinition>
