<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Device Platform Admin</label>
    <description>The Cloud Agentic IoT app, its tabs, every device and telemetry field, the Re-provision button and the live status card. Admins need it too: fields deployed through the Metadata API give no profile any field access.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <applicationVisibilities>
        <application>Cloud_Agentic_IoT</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>DeviceLiveController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DeviceReprovisionController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Field-level security. Required fields (Device_Command__c.Device__c,
         Patient_Vitals__c.Device__c and Device_Reading_Id__c,
         Wi_Fi_Network__c.SSID__c) are left out because Salesforce refuses FLS
         entries on them; they are always readable and editable.
         Patient_Vitals__c is read-only: readings come from the devices, and a
         hand-edited reading would be a falsified clinical record.
         Wi_Fi_Network__c.Passphrase__c is editable so an admin can set it, and
         stays masked: this permission set does not grant View Encrypted Data. -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Certificate_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Connection_Since__c, Connection_Status__c and Last_Disconnect_Reason__c
         are read-only: AWS IoT's connect and disconnect events set them, and a
         hand-edited value would say a board is online when it is not. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Connection_Since__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Connection_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Firmware_Version__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Last_Disconnect_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Last_Telemetry_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Provisioning_Bundle_Link__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Provisioning_Error__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Provisioning_Expires_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Provisioning_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Thing_ARN__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Thing_Group__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Asset.Wi_Fi_Network__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Device_Command__c.Command__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Device_Command__c.Requested_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Device_Command__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Wi_Fi_Network__c.Passphrase__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.BP_Diastolic__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.BP_Systolic__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Heart_Rate__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Humidity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Patient_State__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Previous_State__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Risk_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Source_System__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.SpO2__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Temperature__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Timestamp__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Object access, so the permission set stands on its own; an admin
         profile already grants more. No Delete here: deleting an Asset tears
         its Thing down in AWS, so that stays with the profile. -->
    <objectPermissions>
        <object>Asset</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- Salesforce refuses Read on Asset without Read on Account. -->
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Wi_Fi_Network__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Device_Command__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Patient_Vitals__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>standard-Asset</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Patient_Vitals__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Device_Command__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Wi_Fi_Network__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
