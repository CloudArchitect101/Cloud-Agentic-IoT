<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Patient Care Agent</label>
    <description>For care team members who use the Patient Care Agent: the agent itself, its two actions (read a device's latest readings, escalate to the care team queue), and the device, reading and Case access those actions run with. The agent is an employee agent, so it acts as the person talking to it.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <!-- Which employee agent assigned users may open (PermissionSet
         agentAccesses, API 63.0 and later). The Bot ships in
         bots/Patient_Care_Agent. -->
    <agentAccesses>
        <agentName>Patient_Care_Agent</agentName>
        <enabled>true</enabled>
    </agentAccesses>
    <classAccesses>
        <apexClass>DeviceReadingsAgentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PatientCareAgentActions</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Field-level security for what DeviceReadingsAgentAction reads WITH
         USER_MODE. Patient_Vitals__c.Device__c and Device_Reading_Id__c are
         required fields, which Salesforce refuses FLS entries on; they are
         always readable. Everything here is read-only: the agent reports
         readings and connection state, it never edits them. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Connection_Since__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Connection_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Last_Disconnect_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Asset.Last_Telemetry_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.BP_Diastolic__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.BP_Systolic__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Heart_Rate__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Humidity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Patient_State__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Risk_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Room_Temperature_Alert__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.SpO2__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Temperature__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Patient_Vitals__c.Timestamp__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Account read because an Asset's access follows its Account. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Asset</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- Create and read only: the escalation action creates the Case, the
         care team works it from the queue. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Case</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- View All: Patient_Vitals__c is Private and every reading is owned by
         the integration user that syncs it from AWS, so read alone would show
         a care team member no reading at all. Read-only, and only this
         object. A sharing rule to a care team group is the narrower choice
         for an org with real patients. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Patient_Vitals__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
