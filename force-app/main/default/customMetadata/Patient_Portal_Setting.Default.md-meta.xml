<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Default</label>
    <protected>false</protected>
    <values>
        <field>Certificate_Name__c</field>
        <value xsi:type="xsd:string">Patient_Portal_Chat</value>
    </values>
    <values>
        <field>Key_Id__c</field>
        <value xsi:type="xsd:string">patient-portal-chat-1</value>
    </values>
    <values>
        <field>Issuer__c</field>
        <value xsi:type="xsd:string">cloud-agentic-iot-patient-portal</value>
    </values>
    <values>
        <field>Deployment_Name__c</field>
        <value xsi:type="xsd:string">Patient_Portal_Chat</value>
    </values>
    <!-- Chat_Site_Url__c and Scrt_Url__c are not named here on purpose. Each
         org has its own chat site, and a deploy sets every field a record
         names, so naming them would put one org's URL into every other org
         and reset what an admin typed. A field a deploy does not name keeps
         the org's value: scripts/set-portal-chat-url.sh stores the chat URL
         once per org (docs/INSTALL.md, step 10).
         test/config/per-org-values.test.js keeps them out of this file. -->
    <values>
        <field>Token_Minutes__c</field>
        <value xsi:type="xsd:double">5</value>
    </values>
    <values>
        <field>Nurse_Request_Origin__c</field>
        <value xsi:type="xsd:string">Patient Portal</value>
    </values>
    <values>
        <field>Nurse_Request_Queue__c</field>
        <value xsi:type="xsd:string">Care_Team_Queue</value>
    </values>
</CustomMetadata>
