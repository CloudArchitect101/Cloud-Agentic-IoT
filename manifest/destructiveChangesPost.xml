<?xml version="1.0" encoding="UTF-8"?>
<!--
  What deploy-salesforce.sh removes from the org after each deploy: metadata
  taken out of force-app/. A deploy only adds and changes, so without this a
  class deleted from the repo would stay in the org, and its tests would go
  on running there. An org that never had a component only warns, which the
  deploy ignores (a fresh org, a recorded rebuild).

  On a new org every entry below only warns: none of them is part of this
  project. They are components that an org set up from an early prototype of
  it may still hold (a case alert class and its two fields, two dispense
  settings, and old-builder metadata for the portal agent, which is Agent
  Script in aiAuthoringBundles/), and the deploy removes them there.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>CaseAlertService</members>
        <members>CaseAlertServiceTest</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>Patient_Portal_Planner</members>
        <name>GenAiPlannerBundle</name>
    </types>
    <types>
        <members>Patient_Portal_Self_Service</members>
        <name>GenAiPlugin</name>
    </types>
    <types>
        <members>Get_My_Devices</members>
        <members>Request_Nurse</members>
        <name>GenAiFunction</name>
    </types>
    <types>
        <members>Device_Platform_Setting__mdt.Room_Temp_Dispense__c</members>
        <members>Device_Platform_Setting__mdt.Room_Temp_Dispense_Cooldown_Minutes__c</members>
        <members>Asset.Case_Alert_Active__c</members>
        <members>Device_Command__c.Case_Alert_On__c</members>
        <name>CustomField</name>
    </types>
    <version>65.0</version>
</Package>
