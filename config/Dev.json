{
  "description": "Sizing and behaviour of the Dev environment. scripts/deploy-aws.sh passes each stacks.<name> section to the CloudFormation stack of that name as parameter overrides; scripts/ota.sh reads ota; lambdaLogRetentionDays is how long every function's /aws/lambda log group keeps its logs. test/config/environments.test.js fails the checks when a key here is not a parameter of its template. Salesforce's own settings live in Device_Platform_Setting__mdt and Vital_Sign_Threshold__mdt; the clinical bands for AWS are config/vital-thresholds.json. docs/SCALING.md explains each number.",
  "lambdaLogRetentionDays": 14,
  "stacks": {
    "patient-vitals": {
      "KeepReadingsInDynamoDB": "true",
      "ReadingRetentionDays": 30,
      "ArchiveRetentionDays": 90,
      "DataCloudExport": "true",
      "DataCloudExportRetentionDays": 30,
      "RealertIntervalMinutes": 15,
      "RoomTempAlert": "true",
      "RoomTempAlertCelsius": 30,
      "IngestBatchSize": 100,
      "IngestBatchWindowSeconds": 1,
      "IngestMaxConcurrency": 2,
      "IngestMemoryMB": 512,
      "SyncBatchSize": 200,
      "SyncBatchWindowSeconds": 5,
      "SyncMaxConcurrency": 2,
      "PresenceBatchSize": 10,
      "PresenceBatchWindowSeconds": 0,
      "QueueMaxReceiveCount": 5,
      "QueueRetentionSeconds": 345600,
      "IngestMaxAgeSeconds": 300,
      "SalesforceApiVersion": "64.0",
      "SalesforceTokenCacheMinutes": 30,
      "ConfigCacheSeconds": 60,
      "LogRetentionDays": 14
    },
    "queue-relay": {
      "DeviceApiTimeoutSeconds": 20,
      "IotParallelRequests": 4,
      "PublishParallelRequests": 16,
      "ProvisioningMaxConcurrency": 0,
      "DefaultBundleTtlMinutes": 15,
      "BundleRetentionDays": 1,
      "DefaultThingGroup": "fleet-patient-monitor",
      "ApiRateLimit": 20,
      "ApiBurstLimit": 40,
      "SalesforceCallerUserName": "cloud-agentic-iot-salesforce-caller",
      "LiveReadingSeconds": 2,
      "LiveMinutes": 15,
      "SpendCacheHours": 24,
      "SpendCostExplorer": "false"
    },
    "knowledge-indexer": {
      "SearchTimeoutSeconds": 15,
      "IndexCacheSeconds": 300,
      "MinScore": 0.25,
      "IndexVersionsKeptDays": 30
    },
    "mcp-server": {
      "RoomTempAlertCelsius": 30,
      "OfflineAfterMinutes": 5,
      "MaxRoomsScanned": 500,
      "McpTimeoutSeconds": 20
    },
    "streaming": {
      "SalesforceApiVersion": "64.0",
      "SalesforceTokenCacheMinutes": 30,
      "ConfigCacheSeconds": 60,
      "AlertRetryAttempts": 2,
      "AlertMaxEventAgeSeconds": 3600
    },
    "slack-integration": {
      "SalesforceApiVersion": "64.0",
      "SalesforceTokenCacheMinutes": 30,
      "ConfigCacheSeconds": 300
    }
  },
  "ota": {
    "presignedUrlExpiresInSec": 3600,
    "firstRing": {
      "rollout": {
        "maximumPerMinute": 5
      },
      "timeout": {
        "inProgressTimeoutInMinutes": 10
      },
      "abort": {
        "criteriaList": [
          {
            "failureType": "FAILED",
            "action": "CANCEL",
            "thresholdPercentage": 25,
            "minNumberOfExecutedThings": 2
          }
        ]
      }
    },
    "fleet": {
      "rollout": {
        "maximumPerMinute": 10,
        "exponentialRate": {
          "baseRatePerMinute": 5,
          "incrementFactor": 2,
          "rateIncreaseCriteria": {
            "numberOfSucceededThings": 10
          }
        }
      },
      "timeout": {
        "inProgressTimeoutInMinutes": 15
      },
      "abort": {
        "criteriaList": [
          {
            "failureType": "FAILED",
            "action": "CANCEL",
            "thresholdPercentage": 10,
            "minNumberOfExecutedThings": 5
          }
        ]
      }
    }
  },
  "devices": {
    "patient-monitor": {
      "telemetrySeconds": 30
    }
  }
}
