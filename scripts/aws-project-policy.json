{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectServices",
      "Effect": "Allow",
      "Action": [
        "iot:*",
        "lambda:*",
        "s3:*",
        "dynamodb:*",
        "events:*",
        "sqs:*",
        "sns:*",
        "cloudformation:*",
        "apigateway:*",
        "logs:*",
        "cloudwatch:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DescribeParameters",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource",
        "bedrock:InvokeModel",
        "cloudtrail:LookupEvents",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StackRolesAndTheDeployRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:UpdateRole",
        "iam:UpdateRoleDescription", "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies",
        "iam:TagRole", "iam:UntagRole", "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::*:role/cloud-agentic-iot-*",
        "arn:aws:iam::*:role/github-actions-deploy"
      ]
    },
    {
      "Sid": "PassStackRolesToLambdaAndIoT",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/cloud-agentic-iot-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": ["lambda.amazonaws.com", "iot.amazonaws.com"] }
      }
    },
    {
      "Sid": "BootstrapDeployPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy", "iam:DeletePolicy", "iam:GetPolicy", "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion", "iam:DeletePolicyVersion", "iam:ListPolicyVersions",
        "iam:TagPolicy", "iam:UntagPolicy", "iam:ListEntitiesForPolicy"
      ],
      "Resource": "arn:aws:iam::*:policy/cloud-agentic-iot-*"
    },
    {
      "Sid": "BootstrapGitHubOidcProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider", "iam:DeleteOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider", "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:TagOpenIDConnectProvider", "iam:UntagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "BootstrapFindsAnExistingProvider",
      "Effect": "Allow",
      "Action": "iam:ListOpenIDConnectProviders",
      "Resource": "*"
    },
    {
      "Sid": "BootstrapBudget",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:ModifyBudget"],
      "Resource": "arn:aws:budgets::*:budget/cloud-agentic-iot-*"
    },
    {
      "Sid": "NoBillingNoUsers",
      "Effect": "Deny",
      "Action": [
        "aws-portal:*",
        "account:*",
        "iam:CreateUser", "iam:DeleteUser", "iam:CreateAccessKey",
        "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
