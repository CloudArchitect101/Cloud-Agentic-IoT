# .gitignore
#
# This repo is public and meant to be cloned and followed along with. Anything
# that is not source code or documentation stays out: credentials, local tool
# state, build output, editor preferences, and OS clutter.
#
# Rule of thumb when adding here: if it is generated, personal, or secret, it
# does not belong in the repo. Templates (*.example) are the exception and are
# explicitly kept below.

# ---------------------------------------------------------------------------
# Local-only career planning
career/

# Secrets and credentials — the highest-stakes section in a public repo.
# A leaked credential is not recoverable by deleting the commit; treat any
# accidental push as a rotation event.
# ---------------------------------------------------------------------------
secrets.h
.env
.env.*
*.pem
*.pem.crt
*.pem.key
*.key
*.crt
*.p12
*.pfx
*.jks
server.key
credentials
credentials.json
server-*.key
.claude
.sfdx
.sf
content
docs/templates

# AWS local config — never commit a profile or session token
.aws/

# Salesforce auth artifacts
*-auth.json
authFile.json
sfdx-auth-url.txt

# ---------------------------------------------------------------------------
# Keep the templates. These are documentation: they show a reader the shape of
# the file they must create, with placeholders instead of real values. This
# section must stay AFTER the rules above to override them.
# ---------------------------------------------------------------------------
!*.example
!.env.example

# ---------------------------------------------------------------------------
# Salesforce CLI local state
# ---------------------------------------------------------------------------
.sfdx/
.sf/
.localdevserver/
deploy-options.json

# ---------------------------------------------------------------------------
# Node / Lambda
# package.json and package-lock.json ARE committed — they are how someone
# reproduces the same dependency tree.
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
.yarn/

# Output of `aws cloudformation package`
packaged.yaml
packaged.yml

# ---------------------------------------------------------------------------
# Embedded / ESP32 build output
# ---------------------------------------------------------------------------
build/
.build/
*.bin
*.elf
*.hex
*.map
*.o

# ---------------------------------------------------------------------------
# Python (helper scripts)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Infrastructure state — contains resource IDs and sometimes secrets
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
cdk.out/

# ---------------------------------------------------------------------------
# Editors and IDEs — personal preference, not project configuration.
# extensions.json is kept: it tells a cloner which extensions help.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------------------------------------------------------------------------
# AI assistant local state
# .claude/settings.json (shared project config) stays tracked if it exists;
# settings.local.json is personal and does not.
# ---------------------------------------------------------------------------
.claude/settings.local.json
.cursor/
.aider*

# ---------------------------------------------------------------------------
# Logs and scratch files
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
.tmp/
*.bak
*.orig

# Test and coverage output
coverage/
.nyc_output/
test-results/

# ---------------------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Animation workspace - rendered locally, not part of the deployable repo
animations/

# macOS name-collision duplicates from concurrent checkouts
* 2
* 2.*
*\ 2/
